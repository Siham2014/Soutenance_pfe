<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>

        <!-- Connexion MySQL -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
      <property name="hibernate.connection.url">
    jdbc:mysql://localhost:3306/soutenance_pfe?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true
</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">Mysql123@@</property>

        <!-- Dialecte MySQL -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQL8Dialect</property>

        <!-- Afficher les requêtes SQL dans la console -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Création / mise à jour automatique des tables -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Entités -->
        <mapping class="ma.ensah.soutenance.model.entity.Professeur"/>
        <mapping class="ma.ensah.soutenance.model.entity.Etudiant"/>
        <mapping class="ma.ensah.soutenance.model.entity.GroupPfe"/>
        <mapping class="ma.ensah.soutenance.model.entity.VersionRepartition"/>
        <mapping class="ma.ensah.soutenance.model.entity.Salle"/>
        <mapping class="ma.ensah.soutenance.model.entity.Soutenance"/>
        
        
    </session-factory>
</hibernate-configuration>